NODE_ENV=production
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/android_notifications
BEARER_TOKEN=CHANGE_ME_IN_PRODUCTION_SECRET_TOKEN
ADMIN_API_KEY=CHANGE_ME_IN_PRODUCTION_ADMIN_KEY
TRUST_PROXY=true
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
BODY_LIMIT=1mb
LOG_LEVEL=info
LOG_NOTIFICATION_CONTENT=false
